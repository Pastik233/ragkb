# 环境变量清单（示例）。Spring Boot 不会自动读这个文件，
# 请把变量导出到环境变量里：Linux/macOS `export X=...`，Windows PowerShell `$env:X="..."`。

# 阿里云百炼（DashScope）API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 数据库连接（默认值与 docker-compose.yml 一致）
DB_URL=jdbc:postgresql://localhost:5432/ragkb
DB_USERNAME=postgres
DB_PASSWORD=postgres